{
  "name": "marketing-editor",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "build:all": "npm run clean && npm run build:client && npm run build:server",
    "build:client": "tsc --noEmit -p ./package/client && cross-env NODE_ENV=prod webpack --config ./package/client/build/webpack.prod.js",
    "build:server": "cross-env NODE_ENV=prod tsc --p ./package/server",
    "clean": "node scripts/clean.js",
    "dev:all": "concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cross-env NODE_ENV=dev webpack serve --progress --hot --config ./package/client/build/webpack.dev.js",
    "dev:server": "cross-env NODE_ENV=dev nodemon --watch package/server --ext ts --exec \"ts-node --project package/server/tsconfig.json\" package/server/app.ts",
    "dev": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop ecosystem.config.js",
    "dev:pm2": "pm2 start ecosystem.config.js",
    "stop:dev": "node scripts/stop-dev.js",
    "format": "prettier --write './package/**/*.ts' './package/**/*.js'",
    "start": "cross-env NODE_ENV=prod node output/app.js",
    "typecheck": "tsc --noEmit -p ./package/client && tsc --noEmit -p ./package/server"
  },
  "author": "a446628089",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.17.10",
    "@babel/preset-env": "^7.17.10",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-typescript": "^7.16.7",
    "@types/koa": "^2.13.4",
    "@types/koa-router": "^7.4.4",
    "@types/koa-static": "^4.0.2",
    "@types/react": "^18.0.9",
    "@types/react-dom": "^18.0.3",
    "babel-loader": "^8.2.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "css-loader": "^6.7.1",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.6.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.13",
    "postcss-loader": "^6.2.1",
    "prettier": "^2.6.2",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3",
    "webpack": "^5.72.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.9.0",
    "webpack-merge": "^5.8.0",
    "@types/node": "22.10.2",
    "pm2": "7.0.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@reduxjs/toolkit": "^2.2.7",
    "antd": "^4.20.5",
    "axios": "^0.27.2",
    "hotkeys-js": "^3.13.15",
    "koa": "^2.13.4",
    "koa-body": "^5.0.0",
    "koa-router": "^10.1.1",
    "koa-static": "^5.0.0",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-redux": "^9.1.2",
    "redux": "^5.0.1"
  },
  "description": "智能营销运营工作台 · Marketing Editor：低代码营销页面编辑器",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a446628089/marketing-editor.git"
  },
  "contributors": [
    {
      "name": "a446628089",
      "url": "https://github.com/a446628089"
    }
  ],
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22 <23"
  }
}
